# secrets.yaml.example
# Copy this to secrets.yaml (gitignored, never committed) and fill in real values.
# Used by the *_stig_harden.py scripts instead of prompting for these at runtime.
#
# NOTE: The automation host is a Docker container that doesn't persist files
# across recreation (see Lab/topology.md in the vault) - secrets.yaml will need
# to be recreated after a container rebuild, same as any other local-only file.

vtp_password: CHANGE_ME

ntp_auth_key:
  id: 1
  value: CHANGE_ME

radius_key: CHANGE_ME
