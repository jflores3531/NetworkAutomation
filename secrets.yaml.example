# secrets.yaml.example
# Copy this to secrets.yaml (gitignored, never committed) and fill in real values.
# Used by the *_stig_harden.py scripts instead of prompting for these at runtime.
#
# NOTE: The automation host is a Docker container that doesn't persist files
# across recreation (see Lab/topology.md in the vault) - secrets.yaml will need
# to be recreated after a container rebuild, same as any other local-only file.

# VTP domain password, V-220624 (l2_stig_harden.py) / V-220676 (nxos_stig_harden.py).
# Skipped with a warning by both scripts if left blank.
vtp_password: CHANGE_ME

# NTP authentication key, V-220606 (l2_stig_harden.py) / V-220502 (nxos_stig_harden.py) /
# V-215698 (ios_router_stig_harden_global.py). `id` is the key number, `value` is the key string.
# Skipped with a warning by all three scripts if left blank.
ntp_auth_key:
  id: 1
  value: CHANGE_ME

# RADIUS shared secret, V-220587/617 (l2_stig_harden_aaa.py) / V-215709
# (ios_router_stig_harden_aaa.py) - paired with inventory.yaml's
# services.radius_servers. Script aborts if either is missing.
radius_key: CHANGE_ME

# Privileged EXEC (enable) secret. Used two places:
#  - netauto.py connect() - escalates every script's session to privileged EXEC
#    with this value once aaa new-model governs login (no-op if already privileged).
#  - l2_stig_harden_aaa.py / ios_router_stig_harden_aaa.py - pushes this value as
#    `enable secret` first, then verifies it actually works (disable -> enable
#    round-trip) before touching aaa new-model at all. Script aborts if this is
#    blank - it's the only way back into the device if the AAA push goes wrong.
enable_secret: CHANGE_ME

# SNMPv3 auth/priv passwords, V-220604/605 (l2_stig_harden.py) / V-215696/697
# (ios_router_stig_harden_global.py) - used together to create the SNMPv3 user
# (auth sha / priv aes). Skipped with a warning if either is blank; no NMS in
# this lab actually polls it yet.
snmpv3:
  auth_password: CHANGE_ME
  priv_password: CHANGE_ME
