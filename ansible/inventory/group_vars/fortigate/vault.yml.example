---
# Secrets for the fortigate group. Copy to vault.yml, fill in real values,
# THEN encrypt it before committing anything:
#
#   ansible-vault encrypt inventory/group_vars/fortigate/vault.yml
#
# vault.yml is gitignored (see ../../../../.gitignore) - this .example is the
# only version that is tracked. Never commit the real file in plaintext.
# CHANGE_ME matches the convention in ../l2_switches/vault.yml.example and
# ../../../../secrets.yaml.example.

# REST API token, generated on the FortiGate under System > Administrators >
# Create New > REST API Admin. Two things to set there, both of which matter
# more than the token itself:
#
#   - an admin profile scoped to what this automation actually writes, not
#     super_admin
#   - Trusted Hosts restricted to the automation host's address, so a leaked
#     token is useless from anywhere else
#
# The fortigate_baseline role refuses to run while this is empty or still
# CHANGE_ME, rather than sending unauthenticated calls at a firewall.
vault_fortios_access_token: CHANGE_ME
