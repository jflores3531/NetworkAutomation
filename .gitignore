.venv/
__pycache__/
*.pyc

backups/
audit_logs/
ansible/reports/

# Ad-hoc command files passed to push_config.py
commands*.txt

# Plaintext secrets used by the *_stig_harden.py scripts (VTP password, NTP auth
# key, etc.) - never commit this. See secrets.yaml.example for the format.
secrets.yaml


.idea/
.claude/
.agents/
skills-lock.json

# Ansible vault files holding the same secrets as secrets.yaml above. Tracked
# only as .example templates - the real ones are local, never committed. See
# each vault.yml.example for the expected keys.
ansible/inventory/group_vars/*/vault.yml
